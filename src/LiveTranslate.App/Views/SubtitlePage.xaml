<Page
    x:Class="LiveTranslate.App.Views.SubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LiveTranslate.App.Localization">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel
            Margin="28,20,28,28"
            MinWidth="560"
            MaxWidth="820"
            HorizontalAlignment="Left"
            Spacing="12">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:L.SubtitlePageTitle}" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind Vm.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind Vm.StatusText, Mode=OneWay}" />

            <Button
                x:Name="StartStopButton"
                AutomationProperties.AutomationId="StartStopButton"
                Command="{x:Bind Vm.ToggleSessionCommand}"
                Content="{x:Bind Vm.StartStopText, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:L.SourceLanguage}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            IsEnabled="{x:Bind Vm.CanEditSession, Mode=OneWay}"
                            ItemsSource="{x:Bind Vm.SourceLanguages}"
                            SelectedIndex="{x:Bind Vm.SourceLanguageIndex, Mode=TwoWay}" />
                    </StackPanel>

                    <FontIcon
                        Grid.Column="1"
                        Margin="0,28,0,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE72A;" />

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:L.TargetLanguage}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            IsEnabled="{x:Bind Vm.CanEditSession, Mode=OneWay}"
                            ItemsSource="{x:Bind Vm.TargetLanguages}"
                            SelectedIndex="{x:Bind Vm.TargetLanguageIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:L.AudioSource}" />
                    <RadioButtons
                        HorizontalAlignment="Left"
                        IsEnabled="{x:Bind Vm.CanEditSession, Mode=OneWay}"
                        ItemsSource="{x:Bind Vm.AudioSources}"
                        SelectedIndex="{x:Bind Vm.AudioSourceIndex, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{x:Bind Vm.HasPreview, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:L.PreviewTitle}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="3"
                        Text="{x:Bind Vm.InputPreview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Vm.OutputPreview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{x:Bind Vm.CanExport, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Button
                        x:Name="ExportButton"
                        AutomationProperties.AutomationId="ExportButton"
                        Command="{x:Bind Vm.ExportCommand}"
                        Content="{x:Bind loc:L.ExportMarkdown}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Vm.ExportMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
