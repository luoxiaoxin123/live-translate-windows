<Page
    x:Class="LiveTranslate.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LiveTranslate.App.Localization"
    xmlns:vm="using:LiveTranslate.App.ViewModels">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            Margin="28,20,28,28"
            MaxWidth="820"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind loc:L.SettingsTitle}" />

            <!-- API -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind loc:L.SectionApi}" />

                    <TextBox
                        Header="{x:Bind loc:L.EndpointLabel}"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind Vm.Endpoint, Mode=TwoWay}" />

                    <TextBox
                        Header="{x:Bind loc:L.ModelLabel}"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind Vm.ModelId, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:L.ApiKeysLabel}" />

                    <ItemsControl ItemsSource="{x:Bind Vm.ApiKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApiKeyEntry">
                                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        Password="{x:Bind Value, Mode=TwoWay}"
                                        PasswordRevealMode="{x:Bind RevealMode, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind RemoveCommand}"
                                        ToolTipService.ToolTip="{x:Bind loc:L.RemoveKey}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind Vm.AddKeyCommand}" IsEnabled="{x:Bind Vm.CanAddKey, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind loc:L.AddKey}" />
                            </StackPanel>
                        </Button>
                        <CheckBox Content="{x:Bind loc:L.RevealKeys}" IsChecked="{x:Bind Vm.RevealKeys, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Command="{x:Bind Vm.SaveAndTestCommand}"
                            Content="{x:Bind loc:L.SaveAndTest}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind Vm.SaveKeysCommand}" Content="{x:Bind loc:L.SaveKeys}" />
                        <Button
                            Command="{x:Bind Vm.SaveAndTestCancelCommand}"
                            Content="{x:Bind loc:L.Cancel}"
                            Visibility="{x:Bind Vm.IsTesting, Mode=OneWay}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind Vm.IsTesting, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Vm.TestResult, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind loc:L.SectionAppearance}" />

                    <Slider
                        Header="{x:Bind loc:L.FontSizeLabel}"
                        Maximum="32"
                        Minimum="12"
                        StepFrequency="1"
                        Value="{x:Bind Vm.FontSize, Mode=TwoWay}" />

                    <Slider
                        Header="{x:Bind loc:L.OpacityLabel}"
                        Maximum="95"
                        Minimum="10"
                        StepFrequency="5"
                        Value="{x:Bind Vm.OpacityPercent, Mode=TwoWay}" />

                    <ToggleSwitch
                        Header="{x:Bind loc:L.BilingualLabel}"
                        IsOn="{x:Bind Vm.Bilingual, Mode=TwoWay}"
                        OffContent="{x:Bind loc:L.BilingualOff}"
                        OnContent="{x:Bind loc:L.BilingualOn}" />

                    <Button Command="{x:Bind Vm.ResetAppearanceCommand}" Content="{x:Bind loc:L.ResetAppearance}" />
                </StackPanel>
            </Border>

            <!-- Translated voice -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind loc:L.SectionVoice}" />

                    <ToggleSwitch
                        Header="{x:Bind loc:L.PlayVoiceLabel}"
                        IsOn="{x:Bind Vm.PlayTranslatedAudio, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind loc:L.PlayVoiceHint}"
                        TextWrapping="Wrap" />

                    <Slider
                        Header="{x:Bind loc:L.VolumeLabel}"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="5"
                        Value="{x:Bind Vm.VolumePercent, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind loc:L.VolumeBoostHint}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Vm.VolumeBoosted, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind loc:L.SectionAbout}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:L.VersionLabel}" />
                        <TextBlock Text="{x:Bind Vm.VersionText}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind loc:L.AboutDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
